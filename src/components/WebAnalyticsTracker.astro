---
/**
 * Webサイト訪問・流入元・回遊動線トラッカー
 * 見積もりシミュレーターと共通の端末ID・セッションIDを使用し、
 * Googleスプレッドシート「Web履歴」およびGA4へ連携します。
 */
interface Props {
  endpointUrl?: string;
}

const gasEndpoint = Astro.props.endpointUrl || import.meta.env.PUBLIC_GAS_LOG_ENDPOINT_URL || 'https://script.google.com/macros/s/AKfycbwWv5VmeJGCnvvD0U3WTJBkT3ZnrFIj1qUHXXMlF2TA3vn2hSu9J1zp-9fc4PY_whjp/exec';
---

<script is:inline define:vars={{ gasEndpoint }}>
  (function () {
    // 1. 端末ID (永続・localStorage)
    function getOrCreateVisitorId() {
      try {
        let vid = localStorage.getItem('cage_visitor_id');
        if (!vid) {
          vid = 'usr_' + Math.random().toString(36).substring(2, 8);
          localStorage.setItem('cage_visitor_id', vid);
        }
        return vid;
      } catch (e) {
        return 'usr_' + Math.random().toString(36).substring(2, 8);
      }
    }

    // 2. セッションID (訪問毎・sessionStorage)
    function getOrCreateSessionId() {
      try {
        let sid = sessionStorage.getItem('cage_session_id');
        if (!sid) {
          sid = 'ses_' + Math.random().toString(36).substring(2, 8);
          sessionStorage.setItem('cage_session_id', sid);
        }
        return sid;
      } catch (e) {
        return 'ses_' + Math.random().toString(36).substring(2, 8);
      }
    }

    // 3. 現在のページ日本語名マッピング
    function getPageDisplayName() {
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      if (path === '/' || path === '') return 'トップ';
      if (path.includes('/sim')) return '見積もりシステム';
      if (path.includes('/concept')) return 'コンセプト';
      if (path.includes('/options')) return 'オプション一覧';
      if (path.includes('/contact')) return 'お問い合わせ';
      if (path.includes('/legal')) return '特定商取引法';
      if (path.includes('/works')) return '製作事例';
      return document.title.split('-')[0].trim() || path;
    }

    // 4. 流入元カテゴリの判定
    function detectCategory(ref) {
      if (!ref || ref === 'Direct' || ref === '') return '直接 / お気に入り';
      const lower = ref.toLowerCase();
      if (lower.includes('instagram.com')) return 'Instagram';
      if (lower.includes('t.co') || lower.includes('twitter.com') || lower.includes('x.com')) return 'X (Twitter)';
      if (lower.includes('google.')) return 'Google検索';
      if (lower.includes('yahoo.')) return 'Yahoo!検索';
      if (lower.includes('bing.')) return 'Bing検索';
      if (lower.includes('line.me')) return 'LINE';
      if (lower.includes('tiktok.com')) return 'TikTok';
      if (lower.includes('youtube.com') || lower.includes('youtu.be')) return 'YouTube';
      return '外部Webサイト';
    }

    // 5. デバイス情報の取得
    function getDeviceInfo() {
      const ua = navigator.userAgent;
      let type = 'PC';
      if (/iPhone/i.test(ua)) type = 'iPhone';
      else if (/iPad/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)) type = 'iPad';
      else if (/Android/i.test(ua)) type = 'Android';
      else if (/Mac/i.test(ua)) type = 'Mac';
      else if (/Win/i.test(ua)) type = 'Windows';

      let browser = 'Browser';
      if (/Chrome/i.test(ua) && !/Edge|Edg/i.test(ua)) browser = 'Chrome';
      else if (/Safari/i.test(ua) && !/Chrome/i.test(ua)) browser = 'Safari';
      else if (/Edge|Edg/i.test(ua)) browser = 'Edge';
      else if (/Firefox/i.test(ua)) browser = 'Firefox';

      return {
        type,
        browser,
        screen: `${window.innerWidth}x${window.innerHeight}`
      };
    }

    // 6. メイン処理の実行
    function initTracker() {
      const visitorId = getOrCreateVisitorId();
      const sessionId = getOrCreateSessionId();
      const pageName = getPageDisplayName();

      // GA4へのユーザーID・セッションID連携
      if (typeof window.gtag === 'function') {
        window.gtag('set', 'user_properties', {
          visitor_id: visitorId,
          session_id: sessionId
        });
      }

      // セッション内の初回着地情報（Referrer / LP）を保持
      let initialReferrer = sessionStorage.getItem('cage_initial_referrer');
      let landingPage = sessionStorage.getItem('cage_landing_page');

      if (!initialReferrer) {
        initialReferrer = document.referrer || 'Direct';
        // URLパラメータからの流入情報（?ref=, ?utm_source=, ?origin=）があれば優先
        const params = new URLSearchParams(window.location.search);
        const originParam = params.get('origin') || params.get('utm_source') || params.get('ref');
        if (originParam) {
          initialReferrer = `${initialReferrer} [Param:${originParam}]`;
        }
        sessionStorage.setItem('cage_initial_referrer', initialReferrer);
      }

      if (!landingPage) {
        landingPage = window.location.pathname;
        sessionStorage.setItem('cage_landing_page', landingPage);
      }

      // 回遊履歴の更新
      let pageHistory = [];
      try {
        const savedHistory = sessionStorage.getItem('cage_page_history');
        if (savedHistory) pageHistory = JSON.parse(savedHistory);
      } catch (e) {}

      // 直前と異なる場合のみ追加（リロードで同じページ名が連続しないように）
      if (pageHistory.length === 0 || pageHistory[pageHistory.length - 1] !== pageName) {
        pageHistory.push(pageName);
        if (pageHistory.length > 25) pageHistory.shift(); // 最大25件保持
        sessionStorage.setItem('cage_page_history', JSON.stringify(pageHistory));
      }

      // ※「Web履歴」シートは「Web閲覧履歴」に統合されたため、web_accessの送信は停止します。

      // ページ閲覧ログ（離脱時1行追記方式）の開始
      initPageViewTracker(visitorId, initialReferrer, landingPage);
    }

    // 7. ページ閲覧ログ（方式A: 離脱時1行追記方式）のトラッカー
    function initPageViewTracker(visitorId, initialReferrer, landingPage) {
      let startTime = Date.now();
      let hasSent = false;

      // デバイス種別（Mobile / Tablet / Desktop など判別可能な値）の取得
      function getDeviceTypeCategory() {
        const ua = navigator.userAgent;
        let type = 'Desktop';
        if (/(tablet|ipad|playbook|silk)|(android(?!.*mobi))/i.test(ua)) {
          type = 'Tablet';
        } else if (/Mobile|iP(hone|od)|Android|BlackBerry|IEMobile|Kindle|Silk-Accelerated|(hpw|web)OS|Opera M(obi|ini)/i.test(ua)) {
          type = 'Mobile';
        }

        let os = '';
        if (/iPhone/i.test(ua)) os = 'iPhone';
        else if (/iPad/i.test(ua)) os = 'iPad';
        else if (/Android/i.test(ua)) os = 'Android';
        else if (/Mac/i.test(ua)) os = 'Mac';
        else if (/Win/i.test(ua)) os = 'Windows';
        else if (/Linux/i.test(ua)) os = 'Linux';

        return os ? `${type} (${os})` : type;
      }

      function sendPageViewLog() {
        if (hasSent) return;

        const durationSeconds = Math.max(0, Math.round((Date.now() - startTime) / 1000));
        const pagePath = window.location.pathname || '/';
        const pageTitle = document.title || '';
        const referrer = initialReferrer || document.referrer || 'Direct';
        const referrerCategory = detectCategory(referrer);
        const deviceType = getDeviceTypeCategory();
        const screen = `${window.innerWidth}x${window.innerHeight}`;

        const payload = {
          type: 'page_view',
          visitorId: visitorId,
          path: pagePath,
          title: pageTitle,
          duration: durationSeconds,
          referrerCategory: referrerCategory,
          referrer: referrer,
          landingPage: landingPage || pagePath,
          screen: screen,
          deviceType: deviceType
        };

        if (!gasEndpoint || !gasEndpoint.startsWith('http')) return;

        const hostname = window.location.hostname;
        const isLocal = hostname === 'localhost' || hostname === '127.0.0.1';
        const urlParams = new URLSearchParams(window.location.search);
        const forceDebug = urlParams.get('debug_log') === 'true' || urlParams.get('test_log') === 'true';

        // ローカル環境での送信制御（本番環境では自動送信、ローカルではスキップ）
        const SKIP_LOG_ON_LOCALHOST = true;
        if (isLocal && !forceDebug && SKIP_LOG_ON_LOCALHOST) {
          console.log('[PageViewLog] ローカル開発環境のため送信をスキップしました (テスト時はURLに ?debug_log=true を付与):', payload);
          hasSent = true;
          return;
        }

        if (isLocal) {
          console.log('[PageViewLog] (テスト送信) GASへページ閲覧ログを送信:', payload);
        }

        const payloadStr = JSON.stringify(payload);
        let beaconSent = false;

        // 1. navigator.sendBeacon を最優先で使用（ブラウザ終了・ページ離脱時でも通信保証）
        if (navigator.sendBeacon) {
          try {
            const blob = new Blob([payloadStr], { type: 'text/plain;charset=UTF-8' });
            beaconSent = navigator.sendBeacon(gasEndpoint, blob);
          } catch (e) {
            beaconSent = false;
          }
        }

        // 2. sendBeacon が未対応または失敗した場合は fetch (keepalive: true) にフォールバック
        if (!beaconSent && typeof fetch === 'function') {
          try {
            fetch(gasEndpoint, {
              method: 'POST',
              mode: 'no-cors',
              headers: { 'Content-Type': 'application/json' },
              body: payloadStr,
              keepalive: true
            }).catch(function () {});
          } catch (e) {}
        }

        hasSent = true;
      }

      // イベントリスナー登録
      // 1. バックグラウンド移動・タブ切り替え・画面非表示
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') {
          sendPageViewLog();
        } else if (document.visibilityState === 'visible' && hasSent) {
          // タブに戻ってきた場合、新しい閲覧区間としてタイマーとフラグを再開
          hasSent = false;
          startTime = Date.now();
        }
      });

      // 2. ページ離脱・タブ閉じ・画面遷移
      window.addEventListener('pagehide', function () {
        sendPageViewLog();
      });

      // 3. bfcache（ブラウザ戻る/進む）で復元された場合のリセット
      window.addEventListener('pageshow', function (e) {
        if (e.persisted) {
          hasSent = false;
          startTime = Date.now();
        }
      });
    }

    // ページのDOM準備完了時に実行
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTracker);
    } else {
      initTracker();
    }
  })();
</script>
