---
import Layout from '../layouts/Layout.astro';

// ガイドページのメタ情報
const pageTitle = "ケージお届け後のご案内＆セットアップガイド | きなとのケージ屋さん";
---

<Layout title={pageTitle}>
  <main class="guide-page">

    <!-- ===== ヒーローセクション ===== -->
    <header class="guide-hero">
      <div class="hero-bg-shapes">
        <span class="shape s1"></span>
        <span class="shape s2"></span>
        <span class="shape s3"></span>
      </div>
      <div class="container hero-container">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-icon">📦</span>
            <span>ご購入いただいたお客様へ</span>
          </div>
          <h1 class="hero-title">
            ケージお届け後のご案内<br />
            <span class="hero-subtitle">初期確認＆セットアップガイド</span>
          </h1>
          <p class="hero-lead">
            この度は「きなとのケージ屋さん」をお選びいただき、誠にありがとうございます！<br />
            大切なペットちゃんの新しいマイホームを安全・快適にお使いいただくための初期確認手順と、アクリルフィルム剥がし、暖突・配線の取り付け方法を1つにまとめました。
          </p>
        </div>

        <div class="hero-chara-area">
          <div class="hero-speech-bubble">
            無事にお手元に届いたかな？<br />
            開梱からセットアップまで、<br class="pc-br" />
            わたしと一緒に確認していこうね♪
          </div>
          <img
            src="/assets/characters/clean/pose_point_left_back.png"
            alt="きなとちゃん"
            class="hero-chara-img"
          />
        </div>
      </div>
    </header>

    <!-- ===== 目次ナビゲーション ===== -->
    <nav class="guide-nav-section" aria-label="ガイド目次">
      <div class="container">
        <div class="guide-toc-card">
          <h2 class="toc-title">
            <span class="toc-icon">📑</span> もくじ（タップで各手順へジャンプ）
          </h2>
          <div class="toc-grid">
            <a href="#step-check" class="toc-item">
              <span class="toc-num">01</span>
              <span class="toc-text">開梱と初期状態の確認<span class="toc-badge danger">重要</span></span>
            </a>
            <a href="#step-film" class="toc-item">
              <span class="toc-num">02</span>
              <span class="toc-text">アクリル保護フィルムの剥がし方</span>
            </a>
            <a href="#step-dantotsu" class="toc-item">
              <span class="toc-num">03</span>
              <span class="toc-text">暖突の取り付け方法（S / M）</span>
            </a>
            <a href="#step-hole" class="toc-item">
              <span class="toc-num">04</span>
              <span class="toc-text">暖突の穴が合わない場合の処置</span>
            </a>
            <a href="#step-grommet" class="toc-item">
              <span class="toc-num">05</span>
              <span class="toc-text">配線口（グロメット）の通し方</span>
            </a>
            <a href="#step-type-ah" class="toc-item">
              <span class="toc-num">06</span>
              <span class="toc-text">Type AH-B暖突吊り下げ方法</span>
            </a>
            <a href="#step-photo" class="toc-item toc-item-highlight">
              <span class="toc-num">07</span>
              <span class="toc-text">📸 完成写真・レイアウト写真のご提供</span>
            </a>
            <a href="#step-support" class="toc-item">
              <span class="toc-num">08</span>
              <span class="toc-text">アフターサポート＆お問い合わせ</span>
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- ===== 本文コンテンツ ===== -->
    <div class="container guide-content-container">

      <!-- STEP 1: 開梱と状態のご確認 -->
      <section id="step-check" class="guide-step-card">
        <div class="step-header">
          <div class="step-badge-wrap">
            <span class="step-number">STEP 01</span>
            <span class="step-tag tag-urgent">最重要チェック</span>
          </div>
          <h2 class="step-title">ご開梱と商品の状態確認</h2>
          <p class="step-subtitle">ケージが到着しましたら、まずは速やかに開梱して中身をご確認ください</p>
        </div>

        <div class="step-body">
          <p class="step-desc">
            当工房では細心の注意を払い、頑丈な二重梱包にて発送しておりますが、配送中の強い衝撃等により万が一破損が発生してしまう可能性がございます。<br />
            お届け後は速やかに外箱を開梱し、アクリル板の状態をご確認ください。
          </p>

          <!-- 確認項目（アクリル板の割れやヒビ） -->
          <div class="check-single-box">
            <div class="check-icon">🔍</div>
            <div class="check-content">
              <strong>アクリル板（スライド扉・側面パネル）の割れやヒビ</strong>
              <p>正面の引き戸（スライド扉）や側面の透明パネル等に、配送時の衝撃によるヒビ割れや欠け、破損がないかご確認ください。</p>
            </div>
          </div>

          <!-- 重要アラート：規約に基づく保証条件 -->
          <div class="alert-box alert-danger">
            <div class="alert-icon">⚠️</div>
            <div class="alert-text">
              <h3>【万が一、破損や割れ・初期不良があった場合】</h3>
              <p>
                万が一、配送中の事故による破損や仕様書との相違事項がございましたら、<strong>ケージ配達後【3日以内】に必ず当工房までご連絡をお願いいたします。</strong><br />
                初期不良・破損部位の部品交換にて迅速に保証対応をさせていただきます。
              </p>
              
              <div class="warranty-conditions-box">
                <h4>⚠️ 保証適用についての重要なお願い</h4>
                <p class="warning-highlight-text">
                  <strong>※不具合がある場合、絶対に生体やお世話用品を入れて使用開始しないでください！</strong><br />
                  一度生体を入れてしまいますと「中古品」という扱いになり、運送保険の適用や部品交換・再発送がお受けできなくなる場合がございます。
                </p>
                <ul class="condition-list">
                  <li><strong>連絡期日：</strong> ケージ配達後、3日以内にご連絡をいただいた場合に限ります。</li>
                  <li><strong>梱包資材：</strong> 外箱・緩衝材等の梱包資材を破却・廃棄せず保管してください（運送事故調査に必要となります）。</li>
                  <li><strong>使用状態：</strong> 生体やお世話用品を設置してケージとして使用開始していない状態に限ります。</li>
                  <li><strong>対象外事項：</strong> 当方の出荷基準を満たす微細な外観キズ、加工上生じるキズ、加工ムダ穴は保証対象外となります。</li>
                </ul>
                <div class="warranty-link-action">
                  <a href="/warranty" class="warranty-btn" target="_blank" rel="noopener noreferrer">
                    <span>🛡️ 保証規定（初期不良・返品交換についての詳細書）を見る →</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- KINATOちゃんのアドバイス -->
          <div class="chara-tip-box">
            <img src="/assets/characters/clean/pose_think_trouble.png" alt="きなとちゃん" class="tip-chara-img" />
            <div class="tip-speech">
              <div class="tip-name">きなとちゃんからの注意点</div>
              <p>
                運送事故の補償は<strong>【配達後3日以内】</strong>が期日になっているよ！<br />
                もし何か気になる破損があったら、<strong>生体をお家に入れる前に</strong>スマホで写真を撮ってすぐ教えてね！梱包ダンボールも捨てずに取っておいてね！
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- STEP 2: アクリル保護フィルムの剥がし方 -->
      <section id="step-film" class="guide-step-card">
        <div class="step-header">
          <div class="step-badge-wrap">
            <span class="step-number">STEP 02</span>
            <span class="step-tag">傷防止のコツ</span>
          </div>
          <h2 class="step-title">アクリル保護フィルム（クラフト紙）のめくり方</h2>
          <p class="step-subtitle">爪で擦らずテープでペロッと！新品アクリルを傷つけないカンタンな剥がし方</p>
        </div>

        <div class="step-body">
          <p class="step-desc">
            アクリル板の表面には、加工時および配送時の擦り傷を防ぐため、茶色のクラフト保護紙（保護フィルム）が貼られています。<br />
            「端っこが剥がしにくい…」と爪やカッターなどでガリガリ引っ掻いてしまうと、せっかくの新品アクリルに傷がついてしまいますのでご注意ください！
          </p>

          <div class="guide-method-card">
            <h3 class="method-title">💡 道具はこれだけ！テープを使った裏ワザ手順</h3>
            <p class="method-intro">
              セロハンテープやマスキングテープ（紙テープ、ガムテープ等でも可）をご用意ください。
            </p>

            <div class="two-step-flex">
              <div class="step-column-card">
                <div class="col-badge">手順 ①</div>
                <div class="col-img-wrap">
                  <img src="/assets/guide/film_step1.jpg" alt="テープを保護紙からはみ出すように貼り付ける" />
                </div>
                <div class="col-desc">
                  <strong>テープを端からはみ出すように貼る</strong>
                  <p>アクリル板の角や端っこに、テープを保護紙からはみ出すようにペタッと強めに貼り付けます。</p>
                </div>
              </div>

              <div class="step-column-card">
                <div class="col-badge">手順 ②</div>
                <div class="col-img-wrap">
                  <img src="/assets/guide/film_step2.jpg" alt="貼ったテープを持ち上げると保護紙がめくれる" />
                </div>
                <div class="col-desc">
                  <strong>貼ったテープを真上に持ち上げる</strong>
                  <p>テープの端をつまんでクイッと持ち上げると、保護紙が一緒にめくれ上がります！あとは手で優しく全体を剥がしてください。</p>
                </div>
              </div>
            </div>

            <div class="safe-note-box">
              <span class="safe-icon">✨</span>
              <p>
                <strong>安心仕様：</strong> 保護紙は超低粘着（弱粘着・静電気吸着）で貼り付いています。剥がした後にベタベタする糊残りは一切出ませんのでご安心ください。
              </p>
            </div>
          </div>

          <!-- KINATOちゃんのアドバイス -->
          <div class="chara-tip-box">
            <img src="/assets/characters/clean/pose_gutspose_wink.png" alt="きなとちゃん" class="tip-chara-img" />
            <div class="tip-speech">
              <div class="tip-name">きなとちゃんのワンポイントTips</div>
              <p>
                テープで持ち上げるだけで、力もいらず一瞬でめくれるよ！<br />
                保護紙を剥がすと、とってもクリアで綺麗な透明アクリルがお目見えするよ〜！ピカピカの視界を楽しんでね♪
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- STEP 3: 暖突の取り付け方法 -->
      <section id="step-dantotsu" class="guide-step-card">
        <div class="step-header">
          <div class="step-badge-wrap">
            <span class="step-number">STEP 03</span>
            <span class="step-tag">器具の設置</span>
          </div>
          <h2 class="step-title">暖突（ヒーター）の取り付け方法（S / Mサイズ）</h2>
          <p class="step-subtitle">天板の専用ピッチ穴を活用して、一人でもズレずに綺麗に取り付ける手順</p>
        </div>

        <div class="step-body">
          <p class="step-desc">
            ケージ天板（塩ビパンチングパネル）の取付穴ピッチは、みどり商会製「暖突 Sサイズ」「暖突 Mサイズ」のネジ穴間隔に合わせて設計しています。<br />
            暖突本体に付属しているネジ・ワッシャを使用して固定できます。
          </p>

          <!-- 危険注意喚起 -->
          <div class="alert-box alert-warning">
            <div class="alert-icon">🚫</div>
            <div class="alert-text">
              <h3>【暖突を天板の上に「乗せて」のご使用は厳禁です】</h3>
              <p>
                暖突を天板の上に直置き（乗せるだけ）で使用されますと、ヒーターから放たれる高熱により、<strong>天板（塩ビパンチングパネル）が熱変形・歪み・溶損を起こす恐れ</strong>があります。<br />
                必ず天板の内側（ケージ内天井）に吊り下げる形で、ネジ止めにて固定してください。
              </p>
            </div>
          </div>

          <!-- 準備品リスト -->
          <div class="prep-tools-box">
            <h3 class="prep-title">🛠️ ご用意いただくもの</h3>
            <div class="prep-list-grid">
              <div class="prep-item">
                <span class="prep-icon">🔥</span>
                <div>
                  <strong>暖突本体</strong>
                  <p>暖突付属の取付ネジ・ワッシャを使用します。</p>
                </div>
              </div>
              <div class="prep-item">
                <span class="prep-icon">🪛</span>
                <div>
                  <strong>＋ドライバー（No.2サイズ推奨）</strong>
                  <p>※暖突付属の簡易ドライバーは軸が細すぎてネジ山を舐めやすいため、一般的な家庭用ドライバーの使用を強く推奨します。</p>
                </div>
              </div>
              <div class="prep-item">
                <span class="prep-icon">✂️</span>
                <div>
                  <strong>はさみ または カッター</strong>
                  <p>配線グロメットの切り込み加工に使用します。</p>
                </div>
              </div>
            </div>
          </div>

          <!-- プロの手順解説 -->
          <div class="install-steps-wrapper">
            <h3 class="method-title">📋 スムーズに取り付けるための「2段階」手順</h3>
            <p class="method-intro">最初からワッシャを入れると位置合わせが難しくなります。以下の手順で行うと驚くほどスムーズです！</p>

            <div class="install-diagram-row">
              <div class="diagram-img-box">
                <img src="/assets/guide/dantotsu_install_1.jpg" alt="暖突取付方法の準備と注意点" />
              </div>
              <div class="diagram-img-box">
                <img src="/assets/guide/dantotsu_install_2.jpg" alt="暖突取付手順1〜手順5" />
              </div>
            </div>

            <ol class="numbered-step-list">
              <li>
                <div class="step-num-circle">1</div>
                <div class="step-content-detail">
                  <strong>まずはワッシャを使わず、ネジのみで暖突を仮留めする</strong>
                  <p>天板の外側からネジを通し、暖突本体のネジ穴にネジ先を軽く噛み合わせます。4箇所すべてをネジだけで軽く固定することで、本体が落ちず位置が決まります。</p>
                </div>
              </li>
              <li>
                <div class="step-num-circle">2</div>
                <div class="step-content-detail">
                  <strong>1本ずつネジを外し、ワッシャを挟んで本締めする（4箇所すべて）</strong>
                  <p>全体の仮留めができたら、1箇所ずつネジを抜き、ワッシャを通して締め直します。1本ずつ作業することで他の3本が本体を支えてくれるため、ズレることなくガッチリ固定できます。</p>
                </div>
              </li>
            </ol>
          </div>

          <!-- KINATOちゃんのアドバイス -->
          <div class="chara-tip-box">
            <img src="/assets/characters/clean/pose_finger_point_front.png" alt="きなとちゃん" class="tip-chara-img" />
            <div class="tip-speech">
              <div class="tip-name">きなとちゃんの取り付けアドバイス</div>
              <p>
                暖突Lサイズをお使いの場合は、オプションの『暖突Lブラケット』をお使いいただくか、天板の穴を少し広げてお取り付けしてね。<br />
                ネジ穴がほんの少し外側にズレているときは、暖突本体を手で少し「グッ」と押してあげると、すんなり入ることが多いよ！試してみてね♪
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- STEP 4: 暖突取付穴を広げる方法 -->
      <section id="step-hole" class="guide-step-card">
        <div class="step-header">
          <div class="step-badge-wrap">
            <span class="step-number">STEP 04</span>
            <span class="step-tag tag-sub">製品個体差への対応</span>
          </div>
          <h2 class="step-title">暖突の取付穴が合わない場合の対応（穴拡張方法）</h2>
          <p class="step-subtitle">暖突本体の寸法バラツキにより穴がズレている場合の簡単な対処法</p>
        </div>

        <div class="step-body">
          <p class="step-desc">
            ケージ天板の穴間隔は市場流通品の暖突を精密採寸して設計しておりますが、近年、暖突側の製造ロットごとの寸法公差（バラツキ）が大きく、稀にネジ穴が内側にズレて取り付けにくい個体が流通しております。<br />
            穴が内側にズレている場合は、以下の手順で天板の穴を少し広げてご対応をお願いいたします。
          </p>

          <div class="hole-expand-detail">
            <div class="expand-img-wrap">
              <img src="/assets/guide/dantotsu_hole_expand.png" alt="暖突取付穴を広げる方法の図解" />
            </div>

            <div class="expand-steps-content">
              <div class="tool-pill">
                <strong>🔧 準備品：</strong> ドリルネジ（ケージに同封しております）＋ ドライバー（太めのNo.3推奨）
              </div>

              <ul class="expand-list">
                <li>
                  <span class="ex-num">手順 1</span>
                  <div>
                    <strong>広げる必要がある穴に印をつける</strong>
                    <p>暖突を一度仮当てし、どの穴が内側に干渉しているか確認します。※2箇所以上広げる必要がある場合は、4箇所すべて広げると余裕が生まれ取り付けがとても楽になります。</p>
                  </div>
                </li>
                <li>
                  <span class="ex-num">手順 2</span>
                  <div>
                    <strong>ドリルネジをドライバーで押し込む</strong>
                    <p>付属のドリルネジをドライバーで穴に押し込み、グリグリと回します。※ネジを根本までねじ込む必要はありません。先端の太い部分で穴を1〜2mm押し広げるだけで十分です。</p>
                  </div>
                </li>
                <li>
                  <span class="ex-num">手順 3</span>
                  <div>
                    <strong>削りカスを清掃し、暖突を取り付ける</strong>
                    <p>穴が広がったら削り粉などのゴミを綺麗に拭き取り、STEP 03の手順で暖突を取り付けます。</p>
                  </div>
                </li>
              </ul>
            </div>
          </div>

          <!-- KINATOちゃんのアドバイス -->
          <div class="chara-tip-box">
            <img src="/assets/characters/clean/pose_think_trouble.png" alt="きなとちゃん" class="tip-chara-img" />
            <div class="tip-speech">
              <div class="tip-name">きなとちゃんからのメッセージ</div>
              <p>
                「穴が合わない！不良品かな？」と不安になっちゃうかもしれないけれど、暖突本体の個体差によるものなんだ。同封のネジでちょこっと先端を広げてあげれば大丈夫だから、焦らず試してみてね！
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- STEP 5: 天板グロメットへの配線通し方 -->
      <section id="step-grommet" class="guide-step-card">
        <div class="step-header">
          <div class="step-badge-wrap">
            <span class="step-number">STEP 05</span>
            <span class="step-tag">配線と脱走防止</span>
          </div>
          <h2 class="step-title">天板グロメット（配線口）へ暖突コンセントを通す方法</h2>
          <p class="step-subtitle">ケージの外へスマートに配線しつつ、生体の脱走を確実に防ぐ切り込みのコツ</p>
        </div>

        <div class="step-body">
          <p class="step-desc">
            天板にはコード類を綺麗に通すためのゴム製グロメット（配線キャップ）が取り付けられています。<br />
