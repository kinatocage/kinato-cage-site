---
import Layout from '../layouts/Layout.astro';
import { getTypes, getWorks, getSeitai } from '../lib/microcms';

// データの取得
let types: any[] = [];
let allTags: any[] = [];
let recentWorksData: any[] = [];

try {
  const typesResponse = await getTypes({ limit: 100 });
  types = typesResponse.contents || [];


  // タグ一覧と、全製作事例（件数カウント用）、新着事例を取得
  const [tagsResponse, allWorksResponse, recentWorksResponse] = await Promise.all([
    getSeitai({ limit: 100 }),
    getWorks({ limit: 100, fields: 'id,seitainame' }), // 軽量化のためIDと生体のみ
    getWorks({ limit: 100, orders: '-publishedAt' }) // 新着事例（最大100件）
  ]);
  
  const allTagsData = tagsResponse.contents || [];
  const allWorksData = allWorksResponse.contents || [];
  recentWorksData = recentWorksResponse.contents || [];

  // 各タグの製作事例数をカウント
  const tagCounts: Record<string, number> = {};
  allWorksData.forEach((w: any) => {
    if (w.seitainame && Array.isArray(w.seitainame)) {
      w.seitainame.forEach((s: any) => {
        tagCounts[s.id] = (tagCounts[s.id] || 0) + 1;
      });
    }
  });

  // タグ情報に件数を合体
  allTags = allTagsData.map((t: any) => ({
    ...t,
    count: tagCounts[t.id] || 0
  }));

} catch (err) {
  console.error("データの取得に失敗しました。スキーマやAPIキーを確認してください:", err);
}

// beautiful_image の全画像リスト（横スクロールギャラリー用）
const galleryImages = [
  { src: '/assets/beautiful_image/img (1).JPG', alt: '作例1' },
  { src: '/assets/beautiful_image/img (2).JPG', alt: '作例2' },
  { src: '/assets/beautiful_image/img (3).jpeg', alt: '作例3' },
  { src: '/assets/beautiful_image/img (4).jpg', alt: '作例4' },
  { src: '/assets/beautiful_image/img (5).JPG', alt: '作例5' },
  { src: '/assets/beautiful_image/img (6).JPG', alt: '作例6' },
  { src: '/assets/beautiful_image/img (7).jpg', alt: '作例7' },
  { src: '/assets/beautiful_image/img (8).JPG', alt: '作例8' },
  { src: '/assets/beautiful_image/img (9).JPG', alt: '作例9' },
  { src: '/assets/beautiful_image/img (10).JPG', alt: '作例10' },
  { src: '/assets/beautiful_image/img (11).JPG', alt: '作例11' },
  { src: '/assets/beautiful_image/img (12).JPG', alt: '作例12' },
  { src: '/assets/beautiful_image/img (13).jpg', alt: '作例13' },
  { src: '/assets/beautiful_image/img (14).jpg', alt: '作例14' },
  { src: '/assets/beautiful_image/img (15).JPG', alt: '作例15' },
  { src: '/assets/beautiful_image/img (1).jpeg', alt: '作例16' },
  { src: '/assets/beautiful_image/img (2).jpeg', alt: '作例17' },
  { src: '/assets/beautiful_image/img (3).jpg', alt: '作例18' },
  { src: '/assets/beautiful_image/img(16).JPG', alt: '作例19' },
];
---

<Layout title="きなとのケージ屋さん - ペットに優しいおしゃれなケージ">
  <main>
    <!-- ===== Hero Section ===== -->
    <section class="hero">
      <!-- 装飾バブル -->
      <div class="hero-bubble b1"></div>
      <div class="hero-bubble b2"></div>
      <div class="hero-bubble b3"></div>
      <div class="hero-content">
        <h1 class="hero-title">
          アルミフレーム、アクリルを使った<br class="sp-only" />機能性あるケージ
        </h1>
        <p class="hero-subtitle">理想のケージづくりをお手伝いさせて頂きます</p>
        <div class="hero-tags">
          <span class="hero-tag">🦎 爬虫類</span>
          <span class="hero-tag">🐿️ 小動物</span>
          <span class="hero-tag">🏠 オーダーメイド</span>
        </div>
      </div>
      <!-- キャラクター装飾 -->
      <div class="hero-character">
        <img src="/assets/characters/charactor_walk_nobg.png" alt="きなとちゃん" class="hero-char-img" />
      </div>
    </section>

    <!-- ===== コンセプトバナー ===== -->
    <section class="concept-banner container">
      <a href="/concept" class="concept-banner-link card-base" id="concept-banner">
        <div class="concept-banner-content">
          <div class="concept-banner-char-left">
            <img src="/assets/characters/Gemini_Generated_Image_b06dt9b06dt9b06d.png" alt="きなとちゃん" class="concept-banner-char-img" />
          </div>
          <div class="concept-banner-text">
            <span class="concept-banner-label">✨ Our Concept</span>
            <h2 class="concept-banner-title">きなとのケージ屋さんが<br class="sp-only" />大切にしていること</h2>
            <p class="concept-banner-desc">
              飼い主さまとペットちゃんにとって理想のケージづくりをお手伝いさせて頂きます。<br class="pc-only" />
              私たちのモノづくりへの想いをご紹介します。
            </p>
            <span class="concept-banner-cta">コンセプトを読む →</span>
          </div>
          <div class="concept-banner-char">
            <img src="/assets/characters/Gemini_Generated_Image_ow8db5ow8db5ow8d.png" alt="きなとちゃん" class="concept-banner-char-img" />
          </div>
        </div>
      </a>
    </section>

    <!-- ===== 新機能！3D見積もりシミュレーター 特設紹介セクション ===== -->
    <section id="simulator-banner" class="sim-promo-section section">
      <div class="container">
        <div class="sim-promo-card">
          <div class="sim-promo-content">
            <div class="sim-promo-badge-row">
              <span class="sim-promo-badge">✨ 新機能リリース</span>
              <span class="sim-promo-badge-beta">β版公開中</span>
            </div>
            <h2 class="sim-promo-title">
              理想のケージを指先ひとつで3Dプレビュー！<br />
              <span class="sim-promo-highlight">3Dケージ見積もりシミュレーター</span>
            </h2>
            <p class="sim-promo-desc">
              爬虫類・小動物用アルミフレームケージの寸法（幅・奥行・高さ）をミリ単位で自由に変更！<br class="pc-only" />
              リアルタイムに3D表示・概算重量・お見積もり金額をその場で自動計算できます。
            </p>

            <!-- 3つの特長 -->
            <div class="sim-promo-features">
              <div class="sim-feature-item">
                <span class="sim-feature-icon">📐</span>
                <div class="sim-feature-text">
                  <strong>ミリ単位で3D変形</strong>
                  <p>360度ドラッグ回転＆扉開閉もリアルに確認</p>
                </div>
              </div>
              <div class="sim-feature-item">
                <span class="sim-feature-icon">⚡</span>
                <div class="sim-feature-text">
                  <strong>価格＆重量を即時計算</strong>
                  <p>アルミフレームの軽さや耐震指数も一目で判定</p>
                </div>
              </div>
              <div class="sim-feature-item">
                <span class="sim-feature-icon">📋</span>
                <div class="sim-feature-text">
                  <strong>ワンタップで仕様コピー</strong>
                  <p>気に入った仕様をコピーしてそのままDM相談へ</p>
                </div>
              </div>
            </div>

            <!-- β版注記 -->
            <div class="sim-beta-note">
              <span class="sim-note-icon">⚠️</span>
              <p>※ まだβ版なのでオプション選択の制限や価格は多少の誤差があります。正確な見積りはDMにて直接お問い合わせください。</p>
            </div>

            <!-- CTAボタン -->
            <div class="sim-promo-actions">
              <a href="/sim/" class="sim-cta-btn">
                <span>📱 3D見積もりシミュレーターを試す（無料）</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>

          <!-- 右側：シミュレータープレビュー画面 ＆ KINATOちゃん宣伝 -->
          <div class="sim-promo-visual">
            <div class="sim-visual-wrapper">
              <!-- キャラクター＆吹き出しコンテナ -->
              <div class="sim-char-balloon-group">
                <!-- 吹き出し（KINATOちゃんの左側に配置して被りを防止） -->
                <div class="sim-char-speech">
                  3Dでぐるぐる動かせるよ♪<br />ぴったりのサイズを試してみてね！
                </div>
                <!-- KINATOちゃんイラスト画像 -->
                <img src="/sim/character_transparent.png" alt="KINATOちゃん" class="sim-char-image" />
              </div>
              
              <!-- ブラウザ風モックアップ枠 -->
              <div class="sim-mockup-frame">
                <div class="sim-mockup-bar">
                  <span class="mock-dot red"></span>
                  <span class="mock-dot yellow"></span>
                  <span class="mock-dot green"></span>
                  <span class="mock-title">kinato-cage-site.pages.dev/sim/</span>
                </div>
                <img src="/assets/sim-preview.png" alt="3D見積もりシミュレーター 画面イメージ" class="sim-mockup-img" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== 横スクロールギャラリー ===== -->
    <section id="gallery" class="gallery-section section">
      <div class="section-header">
        <h2>作例ギャラリー</h2>
        <p>職人が丁寧に仕上げた、こだわりのケージたち</p>
      </div>
      <div class="gallery-outer">
        <!-- 自動スクロール：同じリストを2回並べて無限ループ -->
        <div class="gallery-marquee-track">
          <div class="gallery-marquee-inner">
            {galleryImages.map((img) => (
              <div class="gallery-card">
                <img src={img.src} alt={img.alt} class="gallery-img" loading="lazy" />
                <div class="gallery-card-shine"></div>
              </div>
            ))}
            {/* ループのためにもう1セット複製 */}
            {galleryImages.map((img) => (
              <div class="gallery-card">
                <img src={img.src} alt={img.alt} class="gallery-img" loading="lazy" />
                <div class="gallery-card-shine"></div>
              </div>
            ))}
          </div>
        </div>
        <!-- 両端フェード -->
        <div class="gallery-fade-left"></div>
        <div class="gallery-fade-right"></div>
      </div>
    </section>

    <!-- ===== Types Section ===== -->
    <section id="types" class="container section">
      <div class="section-header">
        <h2>ケージの種類</h2>
        <p>生体に合わせて選べるバリエーション</p>
      </div>
      
      {types.length > 0 ? (
        <div class="types-grid">
          {types.map(type => (
            <a href={`/types/${type.id}`} class="type-card card-base">
              <div class="type-image-wrapper">
                {type.image && type.image.length > 0 ? (
                  <img src={type.image[0].url} alt={type.title} class="type-image" loading="lazy" />
                ) : (
                  <div class="placeholder-image" aria-label="画像なし">🐾</div>
                )}
                <div class="type-overlay">
                  <span class="view-more">詳しく見る →</span>
                </div>
              </div>
              <div class="type-content">
                <h3>{type.title}</h3>
                <p>{type.description}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">Typeデータがありません。microCMSで入稿してください。</p>
      )}
    </section>

    <!-- ===== Works Section ===== -->
    <section id="works" class="section works-section">
      <div class="container">
        <div class="section-header">
          <h2>製作事例紹介</h2>
          <p>お客様の想いを形にした、世界に一つのケージたち</p>
        </div>

        {allTags.length > 0 && (
          <div class="tags-filter-container">
            <p class="filter-label">生体タグで絞り込む：</p>
            <div class="filter-tags">
              {allTags.map(tag => (
                tag.count > 0 ? (
                  <a href={`/works/tags/${tag.id}`} class="badge species-badge filter-tag">
                    {tag.name} <span class="tag-count">({tag.count})</span>
                  </a>
                ) : (
                  <span class="badge filter-tag disabled">
                    {tag.name} <span class="tag-count">(0)</span>
                  </span>
                )
              ))}
            </div>
          </div>
        )}

        {recentWorksData.length > 0 && (
          <div class="recent-works-container" style="margin-top: 3rem;">
            <h3 style="text-align: center; margin-bottom: 2rem; font-size: 1.4rem; color: var(--color-primary-dark); font-family: var(--font-heading);">新着の製作事例</h3>
            {/* ページネーション用データをJSON埋め込み */}
            <script id="recent-works-data" type="application/json" set:html={JSON.stringify(recentWorksData)} />
            {/* カード描画エリア（JSが未ロードの場合の初期表示: 先頭3件） */}
            <div id="recent-works-grid" class="works-grid">
              {recentWorksData.slice(0, 3).map((work: any) => (
                <a href={`/works/${work.id}`} class="work-card card-base">
                  <div class="work-image-wrapper">
                    {work.images && work.images.length > 0 ? (
                      <img src={work.images[0].url} alt={work.title} class="work-image" loading="lazy" />
                    ) : (
                      <div class="placeholder-image" aria-label="画像なし">🐾</div>
                    )}
                    <div class="work-overlay">
                      <span class="view-more">詳しく見る →</span>
                    </div>
                    {work.cageType && (
                      <span class="badge type-badge">{work.cageType.title}</span>
                    )}
                  </div>
                  <div class="work-content">
                    <div class="species-badges">
                      {work.seitainame && work.seitainame.map((s: any) => (
                        <span class="badge species-badge">{s.name}</span>
                      ))}
                    </div>
                    <h3 class="work-title">{work.title}</h3>
                    {work.customerComment && (
                      <div class="customer-voice">
                        <span class="voice-icon">💬</span>
                        <p class="voice-text">{work.customerComment}</p>
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
            {/* ページネーションUI */}
            {recentWorksData.length > 3 && (
              <div id="works-pagination" class="works-pagination" aria-label="製作事例ページナビゲーション"></div>
            )}
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  /* ===== Hero ===== */
  .hero {
    position: relative;
    padding: 2.5rem 1.5rem 5rem;
    text-align: center;
    overflow: hidden;
    background: linear-gradient(160deg, #FFF8F5 0%, #FDE8EE 40%, #FFF4E6 100%);
  }

  /* 装飾バブル */
  .hero-bubble {
    position: absolute;
    border-radius: 50%;
    opacity: 0.18;
  }
  .b1 {
    width: 300px; height: 300px;
    background: var(--color-accent);
    top: -80px; left: -80px;
    animation: bubble-drift 8s ease-in-out infinite;
  }
  .b2 {
    width: 200px; height: 200px;
    background: var(--color-accent-warm);
    bottom: -60px; right: -40px;
    animation: bubble-drift 10s ease-in-out infinite reverse;
  }
  .b3 {
    width: 140px; height: 140px;
    background: var(--color-primary-light);
    top: 30%; right: 10%;
    animation: bubble-drift 7s ease-in-out infinite 2s;
  }

  @keyframes bubble-drift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(12px, -16px); }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    line-height: 1.45;
    margin-bottom: 1.25rem;
    font-family: var(--font-heading);
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-light);
    margin-bottom: 2rem;
  }

  /* タグ */
  .hero-tags {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-tag {
    background: white;
    border: 2px solid var(--color-accent);
    color: var(--color-primary-dark);
    padding: 0.4rem 1.1rem;
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    font-family: var(--font-heading);
    font-weight: 600;
    box-shadow: 0 3px 10px rgba(244, 167, 185, 0.2);
    transition: transform 0.2s ease;
  }

  .hero-tag:hover {
    transform: translateY(-2px);
  }

  /* ヒーローキャラクター */
  .hero-character {
    position: absolute;
    bottom: -10px;
    right: 4%;
    z-index: 2;
    pointer-events: none;
  }

  .hero-char-img {
    width: 160px;
    height: auto;
    filter: drop-shadow(0 10px 24px rgba(244, 167, 185, 0.3));
    animation: hero-char-walk 3s ease-in-out infinite;
  }

  @keyframes hero-char-walk {
    0% { transform: translateX(0) translateY(0) rotate(0deg); }
    25% { transform: translateX(12px) translateY(-8px) rotate(6deg); }
    50% { transform: translateX(0) translateY(0) rotate(0deg); }
    75% { transform: translateX(-12px) translateY(-8px) rotate(-6deg); }
    100% { transform: translateX(0) translateY(0) rotate(0deg); }
  }

  .sp-only { display: none; }

  @media (max-width: 768px) {
    .sp-only { display: block; }
    .hero-title { font-size: 1.8rem; }
    .hero { padding: 4rem 1.5rem 5rem; }
    .hero-character { display: none; }
    .hero-logo { width: 70px; height: 70px; }
  }

  /* ===== 新機能！3D見積もりシミュレーター 特設セクション ===== */
  .sim-promo-section {
    padding: 2rem 0 3.5rem;
  }

  .sim-promo-card {
    background: linear-gradient(135deg, #FFFFFF 0%, #FFF5F7 60%, #FFF9F2 100%);
    border: 2px solid #F4A7B9;
    border-radius: 28px;
    box-shadow: 0 12px 36px rgba(244, 167, 185, 0.18);
    padding: 2.75rem;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2.5rem;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .sim-promo-content {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    z-index: 2;
  }

  .sim-promo-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .sim-promo-badge {
    background: linear-gradient(135deg, #E85A7E 0%, #F4A7B9 100%);
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    box-shadow: 0 2px 6px rgba(232, 90, 126, 0.3);
    letter-spacing: 0.5px;
  }

  .sim-promo-badge-beta {
    background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 100%);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    box-shadow: 0 2px 6px rgba(245, 158, 11, 0.3);
  }

  .sim-promo-title {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    line-height: 1.35;
  }

  .sim-promo-highlight {
    background: linear-gradient(135deg, #C84B71 0%, #E85A7E 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .sim-promo-desc {
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .sim-promo-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    margin: 0.3rem 0;
  }

  .sim-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    background: rgba(255, 255, 255, 0.85);
    padding: 0.75rem 0.9rem;
    border-radius: 14px;
    border: 1px solid #F4E4DF;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }

  .sim-feature-icon {
    font-size: 1.25rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .sim-feature-text strong {
    display: block;
    font-size: 0.85rem;
    color: var(--color-primary-dark);
    margin-bottom: 2px;
  }

  .sim-feature-text p {
    font-size: 0.75rem;
    color: var(--color-text-light);
    line-height: 1.4;
  }

  .sim-beta-note {
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: 12px;
    padding: 0.65rem 0.9rem;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    box-shadow: 0 1px 4px rgba(245, 158, 11, 0.08);
  }

  .sim-note-icon {
    font-size: 1rem;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .sim-beta-note p {
    font-size: 0.8rem;
    color: #92400E;
    line-height: 1.5;
    font-weight: 600;
  }

  .sim-promo-actions {
    margin-top: 0.4rem;
  }

  .sim-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #E85A7E 0%, #F4A7B9 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1rem;
    padding: 0.95rem 1.8rem;
    border-radius: 9999px;
    box-shadow: 0 4px 18px rgba(232, 90, 126, 0.35);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
  }

  .sim-cta-btn:hover {
    transform: translateY(-3px) scale(1.02);
